  @EndUserText.label: 'Total Clients'

  @UI: { fieldGroup: [{ qualifier: 'IDGR02', position: 120,label:'Total Clientes' }],
        lineItem: [{ position: 120 ,
    
                  cssDefault.width: '10rem',
