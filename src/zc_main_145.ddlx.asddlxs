@Metadata.layer: #CORE
@UI: {
    headerInfo: {
        typeName: 'Book',
        typeNamePlural: 'Books',
        title:{ type: #STANDARD,value:'IdLibro' },
        description: { type: #STANDARD,value:'Titulo' }
    },
    presentationVariant: [{
        sortOrder: [{ by: 'IdLibro', direction: #DESC  },
        { by: 'Autor', direction: #ASC  }],
        visualizations: [{ type: #AS_LINEITEM }]
    }]
}
annotate entity ZC_MAIN_145 with
{
@UI.facet: [
    {
      id:              'GeneralInfoFacet',
      purpose:         #STANDARD,
      type:            #FIELDGROUP_REFERENCE,
      label:           'Información General',
      targetQualifier: 'IDGR01',
      position:        5
    },{    parentId:        'GeneralInfoFacet' }
    
  ]
  @EndUserText.label: 'ID Libro'
  @UI: {
  
    lineItem: [{ position: 10 }]
  }
  IdLibro;
  @EndUserText.label: 'Bi Categoria'
  @UI: {
--  facet: [{ label:'Informacion Libro',
--             id:'General Info',
--             purpose: #STANDARD  ,
--             position: 10,
-- type: #IDENTIFICATION_REFERENCE 
--         }],
   fieldGroup: [{ qualifier: 'IDGR01', position: 20,label:'Bi Categoria ' }],
   lineItem: [{ position: 20 }],
         selectionField: [{ position: 30 }],
        textArrangement: #TEXT_ONLY
  }
  @Consumption.valueHelpDefinition: [{ entity.name: 'ZI_ACCCATEG_145' , entity.element: 'BiCateg' }]  
  BiCateg;
  @EndUserText.label: 'ID Titulo'
