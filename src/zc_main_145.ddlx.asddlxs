  fieldGroup: [{ qualifier: 'IDGR01', position: 30,label:'Titulo' }],
   lineItem: [{ position: 30 ,label:'Titulo' }]
  }
  Titulo;
  @EndUserText.label: 'Autor'
  @UI: {
  fieldGroup: [{ qualifier: 'IDGR01', position: 40,label:'Autor' }],
    lineItem: [{ position: 40 ,label:'Autor' }]
    ,
        selectionField: [{ position: 10 }],
        textArrangement: #TEXT_ONLY
  }
  Autor;
  @EndUserText.label: 'Editorial'
  @UI: {
    fieldGroup: [{ qualifier: 'IDGR01',position: 50,label:'Editorial' }],
    lineItem: [{ position: 50 }],
        selectionField: [{ position: 20 }],
        textArrangement: #TEXT_ONLY
  }
  Editorial;
@UI.facet: [
    {
      id:              'GeneralInfoFacet2',
      purpose:         #STANDARD,
      type:            #FIELDGROUP_REFERENCE,
      label:           'Información General 2',
      targetQualifier: 'IDGR02',
      position:        55
      
    },{    parentId:        'GeneralInfoFacet2' }
    
  ]  
  @EndUserText.label: 'Idioma'
  @UI: {
    fieldGroup: [{ qualifier: 'IDGR02',position: 60,label:'Idioma' }],
        lineItem: [{ position: 60 }]
    }
  Idioma;
  @EndUserText.label: 'Páginas'
  @UI: {
    fieldGroup: [{ qualifier: 'IDGR02', position: 70,label:'Páginas' }],
        lineItem: [{ position: 70 }]
    }
  Paginas;
  @EndUserText.label: 'Precio'
  @UI: {
      fieldGroup: [{ qualifier: 'IDGR02', position: 80,label:'Precio' }],
        lineItem: [{ position: 80 }]
    }
  Precio;
  @EndUserText.label: 'Moneda'
  @UI: {
  fieldGroup: [{ qualifier: 'IDGR02', position: 90,label:'Moneda' }],
        lineItem: [{ position: 90 }]
    }
  Moneda;
  @EndUserText.label: 'Formato'
  @UI: {
